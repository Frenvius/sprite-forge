{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "sprite-forge",
	"version": "0.3.1",
	"identifier": "com.frenvius.spriteforge.app",
	"build": {
		"beforeDevCommand": "bun run dev:vite",
		"beforeBuildCommand": "bun run build:vite",
		"devUrl": "http://localhost:8080",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "Sprite Forge",
				"width": 1300,
				"height": 800,
				"minWidth": 1300,
				"minHeight": 800,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"dragDropEnabled": true,
				"backgroundColor": [
					0,
					0,
					0,
					0
				]
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["nsis"],
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"installMode": "currentUser"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/256x256.png",
			"icons/512x512.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MDc0OTY2MzQ3MTA1QTkKUldTcEJYRTBaa2tIcERmaTdIdGd6dkZkNkk2c2VEZmdPNHZFTEthVU9qdXVJSWpCcENwVjJzVDUK",
			"endpoints": [
				"https://raw.githubusercontent.com/Frenvius/sprite-forge/main/public/updater.json"
			]
		}
	}
}